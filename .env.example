# ============================================================
# Resume Builder — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── GitHub / Registry ────────────────────────────────────────
# Your GitHub username — images are pulled from ghcr.io/GITHUB_OWNER/...
GITHUB_OWNER=krakupkiwi
# Pin to a specific release tag, or leave as "latest"
IMAGE_TAG=latest

# ── AI Provider ─────────────────────────────────────────────
# Choose one: claude | openai | ollama
AI_PROVIDER=claude

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (local, self-hosted)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Database & Storage ───────────────────────────────────────
DATABASE_URL=sqlite:////data/resume_builder.db
STORAGE_PATH=/data/files

# ── Redis (Celery broker) ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Web Search ───────────────────────────────────────────────
# Choose one: duckduckgo | serpapi
SEARCH_PROVIDER=duckduckgo
SERPAPI_KEY=

# ── Application ──────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=false

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=3000
API_PORT=8000
